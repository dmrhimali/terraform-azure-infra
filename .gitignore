# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform vars — contain secrets
*.tfvars
*.tfvars.json
# Allow example files to be committed
!*.tfvars.example

# Terraform internals
.terraform/
crash.log
crash.*.log

# Sensitive override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# OS
.DS_Store
Thumbs.db
